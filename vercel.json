{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "apps/api/src/**,apps/api/prisma/**,packages/shared/src/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/ping",
      "destination": "/api/ping"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
