{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @kinfolk/api exec prisma generate && pnpm --filter @kinfolk/web build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api($|/)).*)",
      "destination": "/index.html"
    }
  ]
}
